{
	"name": "roleplayer",
	"private": true,
	"license": "MIT",
	"version": "0.0.1",
	"description": "An online-centered table-top roleplaying game.",
	"keywords": [
		"roleplaying game"
	],
	"homepage": "https://github.com/noltron000/roleplaying-game#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noltron000/roleplaying-game.git"
	},
	"bugs": {
		"email": "noltron000@gmail.com",
		"url": "https://github.com/noltron000/roleplaying-game/issues"
	},
	"author": {
		"name": "Nolan Kovacik",
		"email": "noltron000@gmail.com",
		"url": "https://nebuloid.dev/"
	},
	"contributors": [
		{
			"name": "Frances Coronel",
			"email": "fvcproductions@gmail.com",
			"url": "https://francescoronel.com/"
		}
	],
	"type": "module",
	"main": "./build/index.mjs",
	"files": ["build"],
	"imports": {
		"#*": {
			"development": "./source/*/index.mts",
			"default": "./build/*/index.mjs"
		},
		"#*.mts": {
			"development": "./source/*.mts",
			"default": "./build/*.mjs"
		},
		"#*.d.mts": {
			"development": "./source/*.d.mts",
			"default": "./build/*.d.mts"
		}
	},
	"exports": {
		"types": "./build/index.d.mts",
		"import": "./build/index.mjs"
	},
	"scripts": {
		"start": "node --conditions=development --import=tsx ./source/index.mts",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "yarn build"
	},
	"dependencies": {
		"json5": "^2.2.3"
	},
	"devDependencies": {
		"@types/node": "^26.6",
		"node": "^26.12",
		"tsx": "^4.23.15",
		"typescript": "^7.0"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
